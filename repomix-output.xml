$marca = trim($_POST['marca'] ?? '');
$modelo = trim($_POST['modelo'] ?? '');
$ano = (int)($_POST['ano'] ?? 0);
$cor = trim($_POST['cor'] ?? '');
$quilometragem = (int)($_POST['quilometragem'] ?? 0);
$renavam = preg_replace('/[^0-9]/', '', $_POST['renavam'] ?? '');
$chassi = strtoupper(trim($_POST['chassi'] ?? ''));

