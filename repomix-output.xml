    public function read(string $name)
    {
        if (\strpos($name, "\0") !== false) {
            return None::create();
        }

        /** @var \PhpOption\Option<string> */
        return Option::fromValue(\getenv($name), false)->filter(static function ($value) {
            return \is_string($value);
        });
