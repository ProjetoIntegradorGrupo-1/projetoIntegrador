<file path="backend/usuarios/processar-edicao.php">
<?php
// processar_edicao_usuario.php
session_start();

// 1. Validação de Autenticação e Autorização
if (!isset($_SESSION['usuario_logado'])) {
    header("Location: ../../backend/php/oqfazer.php?erro=nao_autorizado");
    exit;
}

require_once '../../conexao.php'; 

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    
    // Captura e sanitização dos dados
    $id_usuario    = filter_input(INPUT_POST, 'id_usuario', FILTER_VALIDATE_INT);
    
    $nome          = trim($_POST['nome'] ?? '');
    $sobrenome     = trim($_POST['sobrenome'] ?? '');
    $nome_completo = trim($nome . ' ' . $sobrenome);
    
    // Tratamento rigoroso para o PostgreSQL (aceita NULL corretamente)
    $dtNascimento  = !empty($_POST['dtNascimento']) ? trim($_POST['dtNascimento']) : null;
    $validade_cnh  = !empty($_POST['validade-cnh']) ? trim($_POST['validade-cnh']) : null;
    
    $genero        = trim($_POST['genero'] ?? '');
    $cpf           = trim($_POST['cpf'] ?? '');
    $cnh           = trim($_POST['cnh'] ?? '');
    $categoria_cnh = trim($_POST['categoria-cnh'] ?? '');
    $telefone      = trim($_POST['telefone'] ?? '');
    $perfil        = trim($_POST['perfil'] ?? '');
    
    $email = filter_input(INPUT_POST, 'email', FILTER_VALIDATE_EMAIL);

    // 2. Validações separadas para fornecer feedback específico à interface
    if (!$id_usuario || empty($nome_completo)) {
        header("Location: ../../backend/php/oqfazer.php?erro=dados_obrigatorios");
        exit;
    }

    if (!$email) {
        header("Location: ../../backend/php/oqfazer.php?erro=email_invalido");
        exit;
    }

    try {
        $sql = "UPDATE Usuarios SET 
                    nome = :nome,
                    email = :email,
                    cpf_matricula = :cpf,
                    perfil = :perfil,
                    dt_nascimento = :dt_nascimento,
                    genero = :genero,
                    cnh = :cnh,
                    validade_cnh = :validade_cnh,
                    categoria_cnh = :categoria_cnh,
                    telefone = :telefone
                WHERE id_usuario = :id_usuario";
        
        $stmt = $pdo->prepare($sql);
        
        $stmt->bindValue(':nome', $nome_completo);
        $stmt->bindValue(':email', $email);
        $stmt->bindValue(':cpf', $cpf);
        $stmt->bindValue(':perfil', $perfil);
        $stmt->bindValue(':dt_nascimento', $dtNascimento, $dtNascimento ? PDO::PARAM_STR : PDO::PARAM_NULL);
        $stmt->bindValue(':genero', $genero);
        $stmt->bindValue(':cnh', $cnh);
        $stmt->bindValue(':validade_cnh', $validade_cnh, $validade_cnh ? PDO::PARAM_STR : PDO::PARAM_NULL);
        $stmt->bindValue(':categoria_cnh', $categoria_cnh);
        $stmt->bindValue(':telefone', $telefone);
        $stmt->bindValue(':id_usuario', $id_usuario, PDO::PARAM_INT);
        
        $stmt->execute();

        header("Location: ../../backend/php/oqfazer.php?sucesso=usuario_atualizado");
        exit;

    } catch (PDOException $e) {
        // Regista o ID do utilizador que falhou para facilitar a depuração no servidor
        error_log("Erro ao atualizar utilizador ID {$id_usuario}: " . $e->getMessage());
        
        header("Location: ../../backend/php/oqfazer.php?erro=falha_banco");
        exit;
    }

} else {
    header("Location: ../../backend/php/oqfazer.php");
    exit;
}
?>
